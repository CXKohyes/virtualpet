{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    /* vite/client 提供图片等资源导入的类型；
       node 只给测试用（petSprites.spec.ts 要读 PNG 头验证尺寸），
       应用代码不要用 Node API。 */
    "types": ["vite/client", "node"],
    "allowArbitraryExtensions": true,

    /* 项目要求：TypeScript 开启 strict，禁止用 any 绕过校验 */
    "strict": true,

    /* 路径别名，与 vite.config.ts 的 resolve.alias 保持一致。
       不使用 baseUrl：TypeScript 6 已弃用该选项，paths 会相对本文件解析。 */
    "paths": {
      "@/*": ["./src/*"]
    },

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.vue"]
}
