# ============================================================
# 像素宠物屋 - 仓库忽略规则
# 目标：构建产物、依赖、日志、IDE 文件、本地配置和密钥一律不入库
# ============================================================

# ---------- Java / Maven 构建产物 ----------
target/
build/
out/
bin/
*.class
*.jar
*.war
*.ear
*.nar

# ---------- Node / 前端构建产物 ----------
node_modules/
dist/
dist-ssr/
.vite/
*.tsbuildinfo
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- 测试与覆盖率产物 ----------
coverage/
.nyc_output/
test-results/
surefire-reports/
failsafe-reports/

# ---------- 本地配置与密钥（严禁提交） ----------
.env
.env.*
!.env.example

# 本机随手记的部署笔记：里面写着明文的 API token / 密码。
# 这类文件不该放在项目目录里，吊销之后记得删。
edgeone部署.txt
*部署.txt

# 放在仓库根目录的参考截图（选服务器时截的图之类）。
# 只挡根目录：精灵图在 pet-web/src/assets/pets/ 下，不受影响。
/*.png

# 本地数据库连接配置（示例文件必须保留：application-local.yml.example）
application-local.yml
application-local.yaml
application-local.properties
*-local.yml
*-local.yaml
*-local.properties
!*.example

# 证书与密钥
*.pem
*.p12
*.pfx
*.key
*.jks
*.keystore
secrets/
.credentials/

# ---------- 本地数据库数据文件 ----------
*.db
*.sqlite
*.sqlite3
*.mv.db
*.trace.db
mysql-data/
docker/mysql/
local-db/

# ---------- 日志 ----------
logs/
log/
*.log
*.log.*
hs_err_pid*
replay_pid*

# ---------- IDE ----------
.idea/
*.iml
*.ipr
*.iws
.classpath
.project
.settings/
.factorypath
nbproject/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo
*~

# ---------- 操作系统 ----------
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---------- 本地验收产物 ----------
# run-virtual-pet skill 的截图输出目录
.artifacts/

# ---------- Claude Code 本地状态 ----------
# .claude/skills/ 是团队共享的，要提交；只忽略本机设置
.claude/settings.local.json
.claude/*.local.json

# ---------- 临时文件 ----------
tmp/
temp/
*.tmp
*.bak
